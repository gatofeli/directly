{
  "manifest_version": 3,
  "author": "Alejandro Aranda Muñoz",
  "name": "Directly",
  "version": "0.0.1.0",
  "version_name": "Beta 1 -Private-",
  "description": "Tu forma más rápida de ir a las webs que usas a diario, con acceso directo y búsqueda integrada.",
  "icons": {
    "16": "assets/logo_16.png",
    "32": "assets/logo_32.png",
    "48": "assets/logo_48.png",
    "128": "assets/logo_128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/logo_16.png",
      "32": "assets/logo_32.png",
      "48": "assets/logo_48.png",
      "128": "assets/logo_128.png"
    },
    "default_title": "Directly"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Space",
        "mac": "MacCtrl+Space"
      }
    }
  }
}
